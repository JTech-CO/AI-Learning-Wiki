{
  "name": "ai-learning-wiki",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run wiki:taxonomy && npm run wiki:evidence && npm run wiki:evidence:audit && npm run wiki:claims && npm run wiki:w4:validate && npm run wiki:w5:validate && npm run wiki:w6:validate && npm run wiki:w7:validate && npm run wiki:w8:validate && npm run wiki:w8:queue && npm run wiki:w9:validate && npm run wiki:w9:queue && npm run validate && npm run wiki:validate && npm run data && npm run gen && npm run wiki:build && npm run wiki:test && npm run validate:generated && astro build && npm run wiki:w3:render && npm run wiki:w4:render && npm run wiki:w5:render && npm run wiki:w6:render && npm run wiki:w7:render && npm run wiki:w8:render && npm run wiki:w9:render && npm run sites:entry && npm run smoke && npm run links && npm run qa",
    "gen": "node scripts/build-pages.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/validate-content.mjs",
    "validate:generated": "node scripts/validate-content.mjs --generated",
    "validate:complete": "node scripts/validate-content.mjs --complete --generated",
    "progress": "node scripts/update-progress.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "data": "node scripts/build-app-data.mjs",
    "links": "node scripts/check-links.mjs",
    "qa": "node scripts/qa-wiki-release.mjs",
    "sites:entry": "node scripts/build-sites-entry.mjs",
    "wiki:seed": "node scripts/seed-wiki-core.mjs && node scripts/enrich-wiki-articles.mjs",
    "wiki:validate": "node scripts/validate-wiki.mjs",
    "wiki:build": "node scripts/build-wiki.mjs && node scripts/build-wiki-specials.mjs",
    "wiki:test": "node scripts/test-wiki.mjs",
    "wiki:taxonomy": "node scripts/build-w0-taxonomy.mjs && node scripts/validate-w0-taxonomy.mjs",
    "wiki:w0:validate": "node scripts/validate-w0-taxonomy.mjs",
    "wiki:evidence": "node scripts/build-w1-evidence-ledger.mjs && node scripts/validate-w1-evidence.mjs",
    "wiki:w1:collect": "node scripts/collect-w1-wikimedia.mjs && npm run wiki:evidence",
    "wiki:w1:validate": "node scripts/validate-w1-evidence.mjs",
    "wiki:evidence:audit": "node scripts/build-w2-evidence-packs.mjs && node scripts/validate-w2-evidence.mjs",
    "wiki:w2:collect": "node scripts/collect-w2-source-verification.mjs && npm run wiki:evidence:audit",
    "wiki:w2:validate": "node scripts/validate-w2-evidence.mjs",
    "wiki:claims": "node scripts/build-w3-claim-review.mjs && node scripts/validate-w3-claim-review.mjs",
    "wiki:w3:validate": "node scripts/validate-w3-claim-review.mjs",
    "wiki:w3:render": "node scripts/check-w3-render.mjs",
    "wiki:w4:refresh": "node scripts/build-w4-claim-ledger.mjs",
    "wiki:w4:validate": "node scripts/validate-w4-claims.mjs",
    "wiki:w4:render": "node scripts/check-w4-render.mjs",
    "wiki:w5:refresh": "node scripts/build-w5-claim-ledger.mjs",
    "wiki:w5:validate": "node scripts/validate-w5-claims.mjs",
    "wiki:w5:render": "node scripts/check-w5-render.mjs",
    "wiki:w6:refresh": "node scripts/build-w6-claim-ledger.mjs",
    "wiki:w6:validate": "node scripts/validate-w6-claims.mjs",
    "wiki:w6:queue": "node scripts/build-w6-production-queue.mjs && node scripts/validate-w6-production-queue.mjs",
    "wiki:w6:render": "node scripts/check-w6-render.mjs",
    "wiki:w2:recheck": "node scripts/collect-w2-source-verification.mjs --refresh && npm run wiki:evidence:audit",
    "wiki:w7:refresh": "node scripts/build-w7-claim-ledger.mjs",
    "wiki:w7:validate": "node scripts/validate-w7-claims.mjs",
    "wiki:w7:queue": "node scripts/build-w7-production-queue.mjs && node scripts/validate-w7-production-queue.mjs",
    "wiki:w7:render": "node scripts/check-w7-render.mjs",
    "wiki:w8:refresh": "node scripts/build-w8-claim-ledger.mjs",
    "wiki:w8:validate": "node scripts/validate-w8-claims.mjs",
    "wiki:w8:queue": "node scripts/validate-w8-production-queue.mjs",
    "wiki:w8:render": "node scripts/check-w8-render.mjs",
    "wiki:w9:prepare": "node scripts/prepare-w9-batch.mjs && node scripts/enrich-w9-existing-depth.mjs && node scripts/prepare-w9-batch.mjs && node scripts/fix-w9-korean-particles.mjs && node scripts/fix-w9-source-titles.mjs",
    "wiki:w9:refresh": "node scripts/build-w9-claim-ledger.mjs",
    "wiki:w9:validate": "node scripts/validate-w9-claims.mjs",
    "wiki:w9:queue": "node scripts/build-w9-production-queue.mjs && node scripts/validate-w9-production-queue.mjs",
    "wiki:w9:render": "node scripts/check-w9-render.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "astro": "^7.0.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
