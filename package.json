{
  "name": "ai-learning-wiki",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run validate && npm run data && npm run gen && npm run validate:generated && astro build && npm run sites:entry && npm run smoke && npm run links && npm run qa",
    "gen": "node scripts/build-pages.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/validate-content.mjs",
    "validate:generated": "node scripts/validate-content.mjs --generated",
    "validate:complete": "node scripts/validate-content.mjs --complete --generated",
    "progress": "node scripts/update-progress.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "data": "node scripts/build-app-data.mjs",
    "links": "node scripts/check-links.mjs",
    "qa": "node scripts/qa-release.mjs",
    "sites:entry": "node scripts/build-sites-entry.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "astro": "^7.0.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
