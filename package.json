{
  "name": "ai-learning-wiki",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run wiki:taxonomy && npm run wiki:evidence && npm run wiki:evidence:audit && npm run wiki:claims && npm run validate && npm run wiki:validate && npm run data && npm run gen && npm run wiki:build && npm run wiki:test && npm run validate:generated && astro build && npm run wiki:w3:render && npm run sites:entry && npm run smoke && npm run links && npm run qa",
    "gen": "node scripts/build-pages.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/validate-content.mjs",
    "validate:generated": "node scripts/validate-content.mjs --generated",
    "validate:complete": "node scripts/validate-content.mjs --complete --generated",
    "progress": "node scripts/update-progress.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "data": "node scripts/build-app-data.mjs",
    "links": "node scripts/check-links.mjs",
    "qa": "node scripts/qa-wiki-release.mjs",
    "sites:entry": "node scripts/build-sites-entry.mjs",
    "wiki:seed": "node scripts/seed-wiki-core.mjs && node scripts/enrich-wiki-articles.mjs",
    "wiki:validate": "node scripts/validate-wiki.mjs",
    "wiki:build": "node scripts/build-wiki.mjs && node scripts/build-wiki-specials.mjs",
    "wiki:test": "node scripts/test-wiki.mjs",
    "wiki:taxonomy": "node scripts/build-w0-taxonomy.mjs && node scripts/validate-w0-taxonomy.mjs",
    "wiki:w0:validate": "node scripts/validate-w0-taxonomy.mjs",
    "wiki:evidence": "node scripts/build-w1-evidence-ledger.mjs && node scripts/validate-w1-evidence.mjs",
    "wiki:w1:collect": "node scripts/collect-w1-wikimedia.mjs && npm run wiki:evidence",
    "wiki:w1:validate": "node scripts/validate-w1-evidence.mjs",
    "wiki:evidence:audit": "node scripts/build-w2-evidence-packs.mjs && node scripts/validate-w2-evidence.mjs",
    "wiki:w2:collect": "node scripts/collect-w2-source-verification.mjs && npm run wiki:evidence:audit",
    "wiki:w2:validate": "node scripts/validate-w2-evidence.mjs",
    "wiki:claims": "node scripts/build-w3-claim-review.mjs && node scripts/validate-w3-claim-review.mjs",
    "wiki:w3:validate": "node scripts/validate-w3-claim-review.mjs",
    "wiki:w3:render": "node scripts/check-w3-render.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "astro": "^7.0.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
