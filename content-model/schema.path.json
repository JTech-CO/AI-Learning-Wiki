{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-learning-wiki/schema/path.json",
  "title": "WikiLearningPath",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "audience", "description", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 20 },
    "level": {
      "type": "string",
      "enum": ["entry", "intermediate", "advanced", "professional"]
    },
    "prerequisiteCourses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "steps": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "required", "reason"],
        "properties": {
          "ref": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "required": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
