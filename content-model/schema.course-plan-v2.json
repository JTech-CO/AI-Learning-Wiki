{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jtech-co.github.io/AI-Learning-Wiki/schema.course-plan-v2.json",
  "title": "AI Learning Wiki professional course plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "order", "title", "level", "status", "deliveryModel", "audience", "estimatedHours", "prerequisites", "learningOutcomes", "phases", "completion", "publicationGate"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "order": { "type": "integer", "minimum": 8 },
    "title": { "$ref": "#/$defs/title" },
    "level": { "const": "professional" },
    "status": { "enum": ["planned", "review", "active"] },
    "deliveryModel": { "const": "ordered-wiki-path" },
    "audience": { "type": "string", "minLength": 20 },
    "estimatedHours": { "type": "integer", "minimum": 12, "maximum": 40 },
    "prerequisites": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "learningOutcomes": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 10 } },
    "phases": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/phase" } },
    "completion": {
      "type": "object", "additionalProperties": false, "required": ["requiredSteps", "assessment"],
      "properties": { "requiredSteps": { "type": "integer", "minimum": 20, "maximum": 30 }, "assessment": { "type": "string", "minLength": 20 } }
    },
    "publicationGate": {
      "type": "object", "additionalProperties": false, "required": ["articleCandidatesReady", "editorialReviewRequired", "activateAfter"],
      "properties": { "articleCandidatesReady": { "type": "boolean" }, "editorialReviewRequired": { "const": true }, "activateAfter": { "type": "string", "pattern": "^W[0-9]+$" } }
    }
  },
  "$defs": {
    "title": {
      "type": "object", "additionalProperties": false, "required": ["ko", "en"],
      "properties": { "ko": { "type": "string", "minLength": 2 }, "en": { "type": "string", "minLength": 2 } }
    },
    "phase": {
      "type": "object", "additionalProperties": false, "required": ["id", "order", "title", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^phase-[1-4]$" },
        "order": { "type": "integer", "minimum": 1, "maximum": 4 },
        "title": { "$ref": "#/$defs/title" },
        "steps": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["order", "refType", "title", "rationale"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 24 },
        "refType": { "enum": ["existing", "planned"] },
        "articleId": { "type": "string" },
        "candidateId": { "type": "string" },
        "title": { "$ref": "#/$defs/title" },
        "rationale": { "type": "string", "minLength": 20 }
      },
      "oneOf": [
        { "required": ["articleId"], "not": { "required": ["candidateId"] } },
        { "required": ["candidateId"], "not": { "required": ["articleId"] } }
      ]
    }
  }
}
