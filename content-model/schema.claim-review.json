{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-learning-wiki/schema/claim-review.json",
  "title": "WikiSectionClaimReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope", "policy", "articles"],
  "properties": {
    "version": { "type": "string", "pattern": "^W3-" },
    "scope": { "type": "string", "minLength": 10 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceBase", "factualSectionIds", "excludedSectionIds", "sourceCoverageReview", "claimVerification", "publicationReadyAfterMapping"],
      "properties": {
        "referenceBase": { "const": 1 },
        "factualSectionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "excludedSectionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "sourceCoverageReview": { "const": "document-scope-reviewed" },
        "claimVerification": { "const": "pending-line-review" },
        "publicationReadyAfterMapping": { "const": false }
      }
    },
    "articles": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["articleId", "sectionRefs"],
        "properties": {
          "articleId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "sectionRefs": {
            "type": "object",
            "minProperties": 9,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
