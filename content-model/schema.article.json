{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-learning-wiki/schema/article.json",
  "title": "WikiArticle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "englishTitle",
    "aliases",
    "summary",
    "sections",
    "categories",
    "prerequisites",
    "related",
    "sources",
    "status",
    "volatility",
    "reviewedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "englishTitle": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 25
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 60
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "type"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string",
            "enum": [
              "paper",
              "specification",
              "documentation",
              "book",
              "standard",
              "encyclopedia"
            ]
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "stub",
        "draft",
        "reviewed"
      ]
    },
    "volatility": {
      "type": "string",
      "enum": [
        "evergreen",
        "periodic",
        "fast-changing"
      ]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date"
    }
  }
}
