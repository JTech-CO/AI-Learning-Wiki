{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-wiki.kr/schemas/lab-tool-v1.json",
  "title": "AI Learning Wiki lab tool manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "order",
    "title",
    "summary",
    "section",
    "route",
    "status",
    "plannedMilestone",
    "audiences",
    "capabilities",
    "execution",
    "contracts",
    "contentLinks",
    "evidence",
    "releaseGate"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/slug" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "#/$defs/i18n" },
    "summary": { "type": "string", "minLength": 20, "maxLength": 240 },
    "section": { "enum": ["learning", "measurement", "validation", "operations"] },
    "route": { "type": "string", "pattern": "^/lab/[a-z0-9]+(?:-[a-z0-9]+)*/$" },
    "status": { "enum": ["planned", "design", "active", "deprecated"] },
    "plannedMilestone": { "type": "string", "pattern": "^(W[0-9]+|backlog)$" },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["learner", "educator", "developer", "operator", "reviewer"] }
    },
    "capabilities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8, "maxLength": 120 }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "networkAccess", "transmitsUserInput", "persistentStorage"],
      "properties": {
        "mode": { "enum": ["client-only", "server-assisted"] },
        "networkAccess": { "enum": ["none", "same-origin-data", "external-api"] },
        "transmitsUserInput": { "type": "boolean" },
        "persistentStorage": { "enum": ["none", "local-only", "account"] }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionSchemaId", "inputFields", "outputFields", "warningDefinitions"],
      "properties": {
        "sessionSchemaId": { "const": "https://ai-wiki.kr/schemas/lab-session-v1.json" },
        "inputFields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inputField" }
        },
        "outputFields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outputField" }
        },
        "warningDefinitions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/warningDefinition" }
        }
      }
    },
    "contentLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wikiSlugs", "courseIds"],
      "properties": {
        "wikiSlugs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "courseIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePolicy", "formulaVersion", "sources"],
      "properties": {
        "sourcePolicy": { "enum": ["internal-derived", "official-primary", "mixed"] },
        "formulaVersion": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "releaseGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministicFixtureCount",
        "keyboardAccessible",
        "mobileLayout",
        "disclosesAssumptions",
        "linksToWiki",
        "noServerData",
        "shareableState"
      ],
      "properties": {
        "deterministicFixtureCount": { "type": "integer", "minimum": 3 },
        "keyboardAccessible": { "const": true },
        "mobileLayout": { "const": true },
        "disclosesAssumptions": { "const": true },
        "linksToWiki": { "const": true },
        "noServerData": { "const": true },
        "shareableState": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 2, "maxLength": 80 },
        "en": { "type": "string", "minLength": 2, "maxLength": 80 }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "label": { "$ref": "#/$defs/i18n" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 1 },
        "options": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "inputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "valueType", "required", "unit", "description", "wikiSlugs"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "$ref": "#/$defs/i18n" },
        "valueType": { "enum": ["article-id", "number", "integer", "boolean", "select", "text", "json"] },
        "required": { "type": "boolean" },
        "unit": { "type": ["string", "null"], "maxLength": 30 },
        "description": { "type": "string", "minLength": 10, "maxLength": 200 },
        "constraints": { "$ref": "#/$defs/constraints" },
        "wikiSlugs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "outputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "valueType", "unit", "precision", "description", "wikiSlugs"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "$ref": "#/$defs/i18n" },
        "valueType": {
          "enum": [
            "number",
            "string",
            "boolean",
            "json",
            "article-path",
            "metric-set",
            "breakdown",
            "validation-report",
            "budget-report",
            "ranking-report"
          ]
        },
        "unit": { "type": ["string", "null"], "maxLength": 30 },
        "precision": { "type": ["integer", "null"], "minimum": 0, "maximum": 8 },
        "description": { "type": "string", "minLength": 10, "maxLength": 200 },
        "wikiSlugs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "warningDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "condition", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "severity": { "enum": ["info", "caution", "blocking"] },
        "condition": { "type": "string", "minLength": 8, "maxLength": 160 },
        "message": { "type": "string", "minLength": 8, "maxLength": 240 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "locator", "version", "accessedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "kind": { "enum": ["internal", "official-documentation", "standard", "paper"] },
        "locator": { "type": "string", "minLength": 3, "maxLength": 300 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "accessedAt": { "type": "string", "format": "date" }
      }
    }
  }
}
