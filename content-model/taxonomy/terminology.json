{
  "version": "W0-2026-07-13",
  "titleRule": "한국어 표제어를 먼저 쓰고 구분 기호 없이 영어 표제어를 이어 쓴다.",
  "firstUseRule": "약어는 첫 등장에 한국어 명칭, 영어 원어, 약어 순서로 푼다.",
  "entries": [
    { "id": "temperature", "preferred": "생성 온도", "english": "Temperature", "avoid": ["정확·사실형", "온도 낮춤"], "note": "디코딩 확률분포를 조절하는 문맥에서는 생성 온도로 쓴다." },
    { "id": "grounding", "preferred": "근거화", "english": "Grounding", "avoid": ["접지"], "note": "출력과 외부 근거를 연결하는 의미다." },
    { "id": "alignment", "preferred": "AI 정렬", "english": "AI Alignment", "avoid": ["얼라인먼트만 단독 사용"], "note": "사람의 의도·가치·안전 제약과 행동을 맞추는 의미다." },
    { "id": "hallucination", "preferred": "환각", "english": "Hallucination", "avoid": ["할루시네이션만 단독 사용"], "note": "사실과 다르거나 근거 없는 생성 결과를 가리킨다." },
    { "id": "bias-term", "preferred": "편향 항", "english": "Bias Term", "avoid": ["편견"], "note": "신경망 수학 문맥에서 사용한다." },
    { "id": "bias-fairness", "preferred": "편향", "english": "Bias", "avoid": ["편향 항"], "note": "사회적·통계적 편향 문맥에서 사용한다." },
    { "id": "attention", "preferred": "어텐션", "english": "Attention", "avoid": ["주의력 메커니즘"], "note": "국내 기술 문헌의 통용 표기를 따른다." },
    { "id": "embedding", "preferred": "임베딩", "english": "Embedding", "avoid": ["삽입"], "note": "데이터를 벡터 표현으로 바꾸는 의미다." },
    { "id": "inference", "preferred": "추론", "english": "Inference", "avoid": ["유추"], "note": "학습된 모델이 출력을 계산하는 단계다." },
    { "id": "reasoning", "preferred": "추론 과정", "english": "Reasoning", "avoid": ["인퍼런스"], "note": "문제 해결을 위한 중간 사고 과정으로, 실행 단계인 inference와 구분한다." },
    { "id": "fine-tuning", "preferred": "미세조정", "english": "Fine-Tuning", "avoid": ["파인튜닝만 단독 사용"], "note": "제목에서는 미세조정을 우선한다." },
    { "id": "post-training", "preferred": "사후학습", "english": "Post-Training", "avoid": ["후학습"], "note": "사전학습 뒤의 SFT·선호 최적화 등을 포괄한다." },
    { "id": "retrieval", "preferred": "검색", "english": "Retrieval", "avoid": ["회수"], "note": "정보 검색 문맥에서 사용한다." },
    { "id": "reranker", "preferred": "리랭커", "english": "Reranker", "avoid": ["재순위자"], "note": "본문 첫 등장에 재순위 모델임을 설명한다." },
    { "id": "chunking", "preferred": "청킹", "english": "Chunking", "avoid": ["덩어리화"], "note": "본문 첫 등장에 문서 분할임을 설명한다." },
    { "id": "tool-calling", "preferred": "도구 호출", "english": "Tool Calling", "avoid": ["툴 콜링만 단독 사용"], "note": "모델이 외부 기능 호출을 구조화해 요청하는 의미다." },
    { "id": "structured-output", "preferred": "구조화 출력", "english": "Structured Output", "avoid": ["구조적 출력"], "note": "스키마 또는 형식 제약을 따르는 출력이다." },
    { "id": "agent", "preferred": "AI 에이전트", "english": "AI Agent", "avoid": ["대리인"], "note": "목표에 따라 도구와 상태를 사용해 여러 단계를 수행하는 시스템이다." },
    { "id": "observability", "preferred": "관측성", "english": "Observability", "avoid": ["관찰 가능성"], "note": "로그·추적·지표로 내부 상태를 이해하는 운영 개념이다." },
    { "id": "throughput", "preferred": "처리량", "english": "Throughput", "avoid": ["스루풋만 단독 사용"], "note": "단위 시간당 처리되는 요청 또는 토큰 수다." },
    { "id": "latency", "preferred": "지연 시간", "english": "Latency", "avoid": ["레이턴시만 단독 사용"], "note": "요청부터 응답까지 걸리는 시간이다." },
    { "id": "open-source-model", "preferred": "오픈소스 모델", "english": "Open-Source Model", "avoid": ["가중치 공개 모델과 혼용"], "note": "오픈 웨이트와 구분하고 실제 라이선스를 확인한다." },
    { "id": "open-weight-model", "preferred": "오픈 웨이트 모델", "english": "Open-Weight Model", "avoid": ["무조건 오픈소스 모델"], "note": "가중치 공개 여부와 소스·데이터·라이선스 공개 여부를 분리한다." },
    { "id": "precision", "preferred": "정밀도", "english": "Precision", "avoid": ["정확도"], "note": "양성으로 예측한 항목 중 실제 양성의 비율이다." },
    { "id": "recall", "preferred": "재현율", "english": "Recall", "avoid": ["회수율"], "note": "실제 양성 중 찾아낸 비율이다." },
    { "id": "accuracy", "preferred": "정확도", "english": "Accuracy", "avoid": ["정밀도"], "note": "전체 예측 중 맞은 비율이다." },
    { "id": "fairness", "preferred": "공정성", "english": "Fairness", "avoid": ["공평성"], "note": "정의와 지표가 여러 가지이므로 사용한 기준을 명시한다." },
    { "id": "safety-security", "preferred": "안전·보안", "english": "Safety and Security", "avoid": ["동일 개념으로 취급"], "note": "의도치 않은 위해와 적대적 공격을 구분해 설명한다." },
    { "id": "context-window", "preferred": "컨텍스트 윈도우", "english": "Context Window", "avoid": ["문맥 창만 단독 사용"], "note": "모델이 한 요청에서 참조할 수 있는 토큰 범위다." },
    { "id": "model-context-protocol", "preferred": "모델 컨텍스트 프로토콜", "english": "Model Context Protocol", "avoid": ["MCP만 첫 등장에 사용"], "note": "첫 등장에 MCP 약어를 함께 제시하고 명세 버전을 기록한다." }
  ]
}
