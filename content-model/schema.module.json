{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-learning-wiki/schema/module.json",
  "title": "WikiModule",
  "description": "위키의 원자 콘텐츠 단위. EduVerse 레슨 한 개 또는 자체 제작 학습 모듈 한 개에 대응한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "course",
    "order",
    "title",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "course": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/i18nString"
    },
    "summary": {
      "$ref": "#/$defs/i18nString"
    },
    "body": {
      "$ref": "#/$defs/i18nMarkdown"
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/i18nString"
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prompt"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "mission": {
      "$ref": "#/$defs/i18nMarkdown"
    },
    "rubric": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rubricItem"
      }
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "intro",
        "basic",
        "intermediate",
        "advanced",
        "pro"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "i18nString": {
      "type": "object",
      "required": [
        "ko"
      ],
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        },
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "i18nMarkdown": {
      "type": "object",
      "required": [
        "ko"
      ],
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        },
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "promptExample": {
      "type": "object",
      "required": [
        "label",
        "input"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/i18nString"
        },
        "input": {
          "$ref": "#/$defs/i18nMarkdown"
        },
        "output": {
          "$ref": "#/$defs/i18nMarkdown"
        }
      }
    },
    "prompt": {
      "type": "object",
      "required": [
        "title",
        "template",
        "examples"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/i18nString"
        },
        "template": {
          "$ref": "#/$defs/i18nMarkdown"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promptExample"
          }
        },
        "notes": {
          "$ref": "#/$defs/i18nMarkdown"
        },
        "model": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "rubricItem": {
      "type": "object",
      "required": [
        "criterion"
      ],
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "$ref": "#/$defs/i18nString"
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "default": 5
        },
        "description": {
          "$ref": "#/$defs/i18nString"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "default": "eduverse-ai.app"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "captureTimeBasis": {
          "type": "string",
          "enum": [
            "observed",
            "file-mtime-estimate",
            "operator-export"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "operator-export",
            "authenticated-crawl",
            "api-capture",
            "manual"
          ]
        },
        "citation": {
          "type": "string",
          "description": "원문에 기록된 참고 문헌 또는 근거 설명"
        }
      }
    }
  }
}
