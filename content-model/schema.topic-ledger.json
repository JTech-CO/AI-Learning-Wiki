{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-learning-wiki/schema/topic-ledger.json",
  "title": "WikiTopicLedger",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "target", "topics"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "perCategory", "total"],
      "properties": {
        "categories": { "type": "integer", "const": 14 },
        "perCategory": { "type": "integer", "const": 100 },
        "total": { "type": "integer", "const": 1400 }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1400,
      "maxItems": 1400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titleKo", "titleEn", "primaryCategory", "subarea", "rank", "tier", "state", "volatility"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "titleKo": { "type": "string", "minLength": 1 },
          "titleEn": { "type": "string", "minLength": 1 },
          "primaryCategory": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "subarea": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "rank": { "type": "integer", "minimum": 1, "maximum": 100 },
          "tier": { "type": "string", "enum": ["core", "standard", "brief"] },
          "state": { "type": "string", "enum": ["existing", "candidate"] },
          "volatility": { "type": "string", "enum": ["evergreen", "periodic", "fast-changing"] }
        }
      }
    }
  }
}
