{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-learning-wiki/schema/production-queue.json",
  "title": "WikiProductionQueue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generatedAt",
    "policy",
    "totals",
    "byCategory",
    "batches",
    "topics"
  ],
  "properties": {
    "version": {
      "enum": [
        "W6-2026-07-13",
        "W7-2026-07-13",
        "W8-2026-07-13",
        "W9-2026-07-13",
        "W10-2026-07-14",
        "W11-2026-07-14"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationRequiresClaimLedger",
        "candidatePublicationAllowed",
        "stageOrder"
      ],
      "properties": {
        "publicationRequiresClaimLedger": {
          "const": true
        },
        "candidatePublicationAllowed": {
          "const": false
        },
        "stageOrder": {
          "type": "array",
          "const": [
            "research-queued",
            "source-remediation",
            "claim-review-queued",
            "published"
          ]
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "categories",
        "batches",
        "existing",
        "candidates",
        "published",
        "sourceRemediation",
        "claimReviewQueued",
        "researchQueued"
      ],
      "properties": {
        "topics": {
          "const": 1400
        },
        "categories": {
          "const": 14
        },
        "batches": {
          "const": 56
        },
        "existing": {
          "type": "integer",
          "minimum": 150,
          "maximum": 1400
        },
        "candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1250
        },
        "published": {
          "type": "integer",
          "minimum": 42,
          "maximum": 1400
        },
        "sourceRemediation": {
          "type": "integer",
          "minimum": 0
        },
        "claimReviewQueued": {
          "type": "integer",
          "minimum": 0
        },
        "researchQueued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1250
        }
      }
    },
    "byCategory": {
      "type": "object",
      "minProperties": 14,
      "maxProperties": 14,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topics",
          "published",
          "existingQueued",
          "candidates"
        ],
        "properties": {
          "topics": {
            "const": 100
          },
          "published": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "existingQueued": {
            "type": "integer",
            "minimum": 0
          },
          "candidates": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "batches": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "categoryId",
          "phase",
          "topicCount",
          "published",
          "queued"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "topicCount": {
            "type": "integer",
            "minimum": 0
          },
          "published": {
            "type": "integer",
            "minimum": 0
          },
          "queued": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1400,
      "maxItems": 1400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topicId",
          "categoryId",
          "tier",
          "state",
          "rank",
          "batchId",
          "stage",
          "publicationReady",
          "evidenceReady",
          "manualReviewRequired",
          "blockers"
        ],
        "properties": {
          "topicId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "categoryId": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "core",
              "standard",
              "brief"
            ]
          },
          "state": {
            "enum": [
              "existing",
              "candidate"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "batchId": {
            "type": "string"
          },
          "stage": {
            "enum": [
              "research-queued",
              "source-remediation",
              "claim-review-queued",
              "published"
            ]
          },
          "publicationReady": {
            "type": "boolean"
          },
          "evidenceReady": {
            "type": "boolean"
          },
          "manualReviewRequired": {
            "type": "boolean"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
