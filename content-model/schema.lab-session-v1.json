{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-wiki.kr/schemas/lab-session-v1.json",
  "title": "AI Learning Wiki lab runtime session v1",
  "description": "브라우저에서 실행되는 AI 실험실 도구의 공통 입력·결과·근거·개인정보 처리 봉투다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolId",
    "toolVersion",
    "locale",
    "resultStatus",
    "inputs",
    "outputs",
    "warnings",
    "assumptions",
    "wikiLinks",
    "provenance",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "toolId": { "$ref": "#/$defs/slug" },
    "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "locale": { "enum": ["ko-KR", "en"] },
    "resultStatus": { "enum": ["ok", "warning", "error"] },
    "inputs": { "type": "object", "minProperties": 1, "additionalProperties": true },
    "outputs": { "type": "object", "minProperties": 1, "additionalProperties": true },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "wikiSlugs"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "severity": { "enum": ["info", "caution", "blocking"] },
          "message": { "type": "string", "minLength": 8, "maxLength": 240 },
          "wikiSlugs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/slug" }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "sourceIds"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "text": { "type": "string", "minLength": 10, "maxLength": 300 },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/slug" }
          }
        }
      }
    },
    "wikiLinks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formulaVersion", "sourceVersions", "calculatedAt"],
      "properties": {
        "formulaVersion": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$" },
        "sourceVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "version": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        },
        "calculatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "networkAccess", "transmitted", "persisted"],
      "properties": {
        "execution": { "const": "client-only" },
        "networkAccess": { "enum": ["none", "same-origin-data"] },
        "transmitted": { "const": false },
        "persisted": { "const": "none" }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
