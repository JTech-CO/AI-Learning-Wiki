---
const basePath = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---

<section class="lab-tool" data-model-memory-calculator data-base-path={basePath}>
  <form class="lab-tool-form" data-model-memory-form>
    <fieldset>
      <legend>모델과 실행 조건</legend>
      <p class="lab-field-note">
        파라미터 수는 십억 개(B) 단위로 입력한다. 같은 정밀도를 가중치와 KV 캐시에 적용한다.
      </p>

      <div class="lab-form-grid lab-memory-form-grid">
        <label class="lab-field">
          <span>파라미터 수 (B)</span>
          <input
            type="number"
            name="parameterBillions"
            min="0.001"
            max="10000"
            step="0.001"
            value="7"
            required
          />
          <small>예: 7B 모델은 7을 입력한다.</small>
        </label>

        <label class="lab-field">
          <span>가중치·KV 정밀도</span>
          <select name="precision">
            <option value="32">FP32 · 32비트</option>
            <option value="16" selected>FP16/BF16 · 16비트</option>
            <option value="8">INT8 · 8비트</option>
            <option value="4">INT4 · 4비트</option>
          </select>
        </label>

        <label class="lab-field">
          <span>실행 모드</span>
          <select name="executionMode">
            <option value="inference" selected>추론</option>
            <option value="training">학습 · Adam 계열</option>
          </select>
        </label>

        <label class="lab-field">
          <span>트랜스포머 레이어</span>
          <input type="number" name="layerCount" min="1" max="1000" step="1" value="32" required />
        </label>

        <label class="lab-field">
          <span>배치 크기</span>
          <input type="number" name="batchSize" min="1" max="100000" step="1" value="1" required />
          <small>동시에 캐시하는 요청 수</small>
        </label>

        <label class="lab-field">
          <span>요청당 문맥 길이</span>
          <input
            type="number"
            name="contextLength"
            min="1"
            max="100000000"
            step="1"
            value="8192"
            required
          />
          <small>프롬프트와 생성 토큰을 합친 최대 캐시 길이</small>
        </label>

        <label class="lab-field">
          <span>KV 헤드 수</span>
          <input type="number" name="kvHeadCount" min="1" max="4096" step="1" value="8" required />
          <small>GQA·MQA 모델은 쿼리 헤드 수보다 작을 수 있다.</small>
        </label>

        <label class="lab-field">
          <span>헤드 차원</span>
          <input type="number" name="headDimension" min="1" max="65536" step="1" value="128" required />
        </label>
      </div>

      <div class="lab-form-actions">
        <button type="submit">메모리 계산하기</button>
        <button type="reset" class="lab-secondary-button">입력 초기화</button>
      </div>
    </fieldset>
  </form>

  <p class="lab-tool-status" data-model-memory-status role="status" aria-live="polite">
    7B GQA 모델의 예시 조건을 계산할 수 있다.
  </p>

  <section class="lab-result" data-model-memory-result hidden tabindex="-1">
    <header class="lab-result-header">
      <div>
        <p class="lab-result-kicker">최소 근사치</p>
        <h2 data-memory-result-title>모델 메모리 구성</h2>
      </div>
      <button type="button" class="lab-secondary-button" data-copy-model-memory-url>
        공유 주소 복사
      </button>
    </header>

    <dl class="lab-result-summary lab-memory-summary">
      <div>
        <dt>모델 가중치</dt>
        <dd data-memory-weight>-</dd>
      </div>
      <div>
        <dt>학습 상태</dt>
        <dd data-memory-training>-</dd>
      </div>
      <div>
        <dt>KV 캐시</dt>
        <dd data-memory-kv>-</dd>
      </div>
      <div>
        <dt>총 추정치</dt>
        <dd data-memory-total>-</dd>
      </div>
    </dl>

    <div class="lab-warning-list" data-model-memory-warnings>
      <h3>추정 범위 주의</h3>
      <ul></ul>
    </div>

    <section aria-labelledby="memory-breakdown-title">
      <h3 id="memory-breakdown-title">구성 요소별 내역</h3>
      <div class="lab-table-scroll">
        <table class="lab-memory-table">
          <thead>
            <tr>
              <th scope="col">구성 요소</th>
              <th scope="col">용량</th>
              <th scope="col">총 추정치 비율</th>
              <th scope="col">계산 기준</th>
            </tr>
          </thead>
          <tbody data-memory-component-rows></tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="kv-context-title">
      <h3 id="kv-context-title">KV 캐시와 문맥 길이</h3>
      <dl class="lab-kv-summary">
        <div>
          <dt>요청당 토큰 1개의 KV 캐시</dt>
          <dd data-kv-per-token>-</dd>
        </div>
        <div>
          <dt>현재 캐시 토큰</dt>
          <dd data-kv-total-tokens>-</dd>
        </div>
        <div>
          <dt>계산식</dt>
          <dd data-kv-formula>-</dd>
        </div>
      </dl>

      <div class="lab-table-scroll">
        <table class="lab-context-table">
          <caption>나머지 조건을 유지했을 때 문맥 길이에 따른 KV 캐시 용량이다.</caption>
          <thead>
            <tr>
              <th scope="col">요청당 문맥</th>
              <th scope="col">배치 전체 토큰</th>
              <th scope="col">KV 캐시</th>
              <th scope="col">현재 조건</th>
            </tr>
          </thead>
          <tbody data-context-scenario-rows></tbody>
        </table>
      </div>
    </section>

    <section data-training-state-section>
      <h3>학습 상태 가정</h3>
      <div class="lab-table-scroll">
        <table class="lab-training-state-table">
          <thead>
            <tr>
              <th scope="col">항목</th>
              <th scope="col">파라미터당 바이트</th>
              <th scope="col">용량</th>
            </tr>
          </thead>
          <tbody data-training-state-rows></tbody>
        </table>
      </div>
    </section>

    <section class="lab-memory-excluded">
      <h3>총 추정치에서 제외한 항목</h3>
      <ul data-memory-excluded-items></ul>
    </section>

    <section class="lab-assumptions">
      <h3>계산 가정</h3>
      <ul data-model-memory-assumptions></ul>
    </section>
  </section>
</section>

<script>
  import {
    calculateModelMemory,
    formatGiB,
    formatMemoryBytes,
  } from '../../lib/model-memory.mjs';

  const calculator = document.querySelector('[data-model-memory-calculator]');

  if (calculator instanceof HTMLElement) {
    const form = calculator.querySelector('[data-model-memory-form]');
    const result = calculator.querySelector('[data-model-memory-result]');
    const status = calculator.querySelector('[data-model-memory-status]');

    const field = (name) => form?.elements.namedItem(name);
    const text = (selector, value) => {
      const element = calculator.querySelector(selector);
      if (element) element.textContent = value;
    };

    const renderWarnings = (warnings) => {
      const list = calculator.querySelector('[data-model-memory-warnings] ul');
      if (!list) return;
      list.replaceChildren();
      for (const warning of warnings) {
        const item = document.createElement('li');
        item.dataset.severity = warning.severity;
        item.textContent = warning.message;
        list.append(item);
      }
    };

    const componentBasis = {
      weights: '파라미터 수 × 선택 정밀도',
      'training-state': '그래디언트 + 옵티마이저 상태 + 필요 시 FP32 마스터 가중치',
      'kv-cache': '키·값 × 레이어 × 배치 × 문맥 × KV 헤드 × 헤드 차원 × 정밀도',
    };

    const renderComponents = (components) => {
      const body = calculator.querySelector('[data-memory-component-rows]');
      if (!body) return;
      body.replaceChildren();

      for (const component of components) {
        const row = document.createElement('tr');
        const name = document.createElement('th');
        name.scope = 'row';
        name.textContent = component.label;
        const capacity = document.createElement('td');
        capacity.textContent = `${formatGiB(component.gib)} GiB`;
        const share = document.createElement('td');
        share.textContent = `${component.sharePercent.toFixed(1)}%`;
        const basis = document.createElement('td');
        basis.textContent = componentBasis[component.id] ?? '';
        row.append(name, capacity, share, basis);
        body.append(row);
      }
    };

    const renderContextScenarios = (scenarios) => {
      const body = calculator.querySelector('[data-context-scenario-rows]');
      if (!body) return;
      body.replaceChildren();

      for (const scenario of scenarios) {
        const row = document.createElement('tr');
        if (scenario.isCurrent) row.className = 'lab-memory-current';
        const context = document.createElement('th');
        context.scope = 'row';
        context.textContent = `${scenario.contextLength.toLocaleString('ko-KR')} 토큰`;
        const totalTokens = document.createElement('td');
        totalTokens.textContent = scenario.totalCachedTokens.toLocaleString('ko-KR');
        const capacity = document.createElement('td');
        capacity.textContent = formatMemoryBytes(scenario.bytes);
        const current = document.createElement('td');
        current.textContent = scenario.isCurrent ? '현재 입력' : '';
        row.append(context, totalTokens, capacity, current);
        body.append(row);
      }
    };

    const renderTrainingState = (calculation) => {
      const section = calculator.querySelector('[data-training-state-section]');
      const body = calculator.querySelector('[data-training-state-rows]');
      if (!section || !body) return;

      section.hidden = calculation.inputs.executionMode !== 'training';
      body.replaceChildren();
      for (const component of calculation.trainingStateMemory.components) {
        const row = document.createElement('tr');
        const name = document.createElement('th');
        name.scope = 'row';
        name.textContent = component.label;
        const perParameter = document.createElement('td');
        perParameter.textContent = component.bytesPerParameter.toLocaleString('ko-KR');
        const capacity = document.createElement('td');
        capacity.textContent = formatMemoryBytes(component.bytes);
        row.append(name, perParameter, capacity);
        body.append(row);
      }
    };

    const renderList = (selector, values, valueKey = null) => {
      const list = calculator.querySelector(selector);
      if (!list) return;
      list.replaceChildren();
      for (const value of values) {
        const item = document.createElement('li');
        item.textContent = valueKey ? value[valueKey] : value;
        list.append(item);
      }
    };

    const updateShareState = (calculation) => {
      const url = new URL(window.location.href);
      url.searchParams.set('paramsB', String(calculation.inputs.parameterCount / 1e9));
      url.searchParams.set('precision', String(calculation.inputs.precision));
      url.searchParams.set('mode', calculation.inputs.executionMode);
      url.searchParams.set('layers', String(calculation.inputs.layerCount));
      url.searchParams.set('batch', String(calculation.inputs.batchSize));
      url.searchParams.set('context', String(calculation.inputs.contextLength));
      url.searchParams.set('kvHeads', String(calculation.inputs.kvHeadCount));
      url.searchParams.set('headDim', String(calculation.inputs.headDimension));
      window.history.replaceState({}, '', url);
    };

    const calculate = ({ updateUrl = true, focusResult = true } = {}) => {
      if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;

      try {
        const parameterBillions = Number(field('parameterBillions')?.value);
        const calculation = calculateModelMemory({
          parameterCount: parameterBillions * 1e9,
          precision: field('precision')?.value,
          executionMode: field('executionMode')?.value,
          layerCount: field('layerCount')?.value,
          batchSize: field('batchSize')?.value,
          contextLength: field('contextLength')?.value,
          kvHeadCount: field('kvHeadCount')?.value,
          headDimension: field('headDimension')?.value,
        });
        const modeLabel = calculation.inputs.executionMode === 'training' ? '학습' : '추론';

        text(
          '[data-memory-result-title]',
          `${parameterBillions.toLocaleString('ko-KR')}B · ${calculation.inputs.precision}비트 · ${modeLabel}`,
        );
        text('[data-memory-weight]', `${formatGiB(calculation.weightMemory.gib)} GiB`);
        text('[data-memory-training]', `${formatGiB(calculation.trainingStateMemory.gib)} GiB`);
        text('[data-memory-kv]', `${formatGiB(calculation.kvCacheMemory.gib)} GiB`);
        text('[data-memory-total]', `${formatGiB(calculation.totalEstimate.gib)} GiB`);
        text(
          '[data-kv-per-token]',
          formatMemoryBytes(calculation.kvCacheMemory.bytesPerTokenPerRequest),
        );
        text(
          '[data-kv-total-tokens]',
          `${calculation.kvCacheMemory.totalCachedTokens.toLocaleString('ko-KR')} 토큰`,
        );
        text('[data-kv-formula]', calculation.kvCacheMemory.formula);

        renderWarnings(calculation.warnings);
        renderComponents(calculation.components);
        renderContextScenarios(calculation.contextScenarios);
        renderTrainingState(calculation);
        renderList('[data-memory-excluded-items]', calculation.excludedItems);
        renderList('[data-model-memory-assumptions]', calculation.assumptions, 'text');
        if (updateUrl) updateShareState(calculation);

        result.hidden = false;
        status.textContent = `총 ${formatGiB(calculation.totalEstimate.gib)} GiB의 최소 근사치를 계산했다. 제외 항목과 가정을 함께 확인해야 한다.`;
        if (focusResult) {
          result.focus({ preventScroll: true });
          result.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch (error) {
        status.textContent = error instanceof Error
          ? error.message
          : '모델 메모리를 계산하는 중 오류가 발생했다.';
      }
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      calculate();
    });

    form?.addEventListener('reset', () => {
      window.setTimeout(() => {
        const url = new URL(window.location.href);
        url.search = '';
        window.history.replaceState({}, '', url);
        calculate({ updateUrl: false, focusResult: false });
        status.textContent = '7B GQA 예시 조건으로 입력을 초기화했다.';
      });
    });

    calculator.querySelector('[data-copy-model-memory-url]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        status.textContent = '현재 모델·KV 캐시 조건이 담긴 주소를 복사했다.';
      } catch {
        status.textContent = `주소 표시줄의 링크를 복사하면 같은 조건을 공유할 수 있다: ${window.location.href}`;
      }
    });

    const params = new URLSearchParams(window.location.search);
    const queryFields = [
      ['paramsB', 'parameterBillions'],
      ['precision', 'precision'],
      ['mode', 'executionMode'],
      ['layers', 'layerCount'],
      ['batch', 'batchSize'],
      ['context', 'contextLength'],
      ['kvHeads', 'kvHeadCount'],
      ['headDim', 'headDimension'],
    ];
    for (const [parameter, fieldName] of queryFields) {
      const input = field(fieldName);
      if (params.has(parameter) && (input instanceof HTMLInputElement || input instanceof HTMLSelectElement)) {
        input.value = params.get(parameter) ?? '';
      }
    }

    calculate({ updateUrl: false, focusResult: false });
  }
</script>
