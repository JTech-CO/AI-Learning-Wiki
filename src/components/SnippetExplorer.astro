<section class="snippet-explorer" aria-labelledby="snippet-explorer-title" data-snippets-url="../data/snippets.json">
  <div class="explorer-controls snippet-controls">
    <label class="explorer-search">코드·설정 검색
      <input id="snippet-query" type="search" placeholder="예: Python, JSON, 웹훅" autocomplete="off" />
    </label>
    <label>자료 유형
      <select id="snippet-type"><option value="">전체 유형</option></select>
    </label>
    <label>연결 코스
      <select id="snippet-course"><option value="">전체 코스</option></select>
    </label>
  </div>
  <p id="snippet-count" class="explorer-count" aria-live="polite">코드·설정 자료를 불러오는 중…</p>
  <div id="snippet-results" class="snippet-results"></div>
  <nav id="snippet-pagination" class="wiki-pagination" aria-label="코드·설정 자료 페이지" hidden>
    <button id="snippet-prev" type="button">이전</button>
    <span id="snippet-page-status" aria-live="polite"></span>
    <button id="snippet-next" type="button">다음</button>
  </nav>
</section>

<script>
  const courseNames = { 'ai-foundations':'AI 기초','llm-internals':'LLM 내부 구조','model-training':'모델 학습과 튜닝','rag-search':'임베딩과 RAG','api-development':'AI API 개발','agent-systems':'AI 에이전트','responsible-ai':'신뢰할 수 있는 AI','multimodal-ai':'멀티모달 AI' };
  const query = document.querySelector('#snippet-query');
  const type = document.querySelector('#snippet-type');
  const course = document.querySelector('#snippet-course');
  const results = document.querySelector('#snippet-results');
  const count = document.querySelector('#snippet-count');
  const pagination = document.querySelector('#snippet-pagination');
  const previousPage = document.querySelector('#snippet-prev');
  const nextPage = document.querySelector('#snippet-next');
  const pageStatus = document.querySelector('#snippet-page-status');
  const dataUrl = document.querySelector('.snippet-explorer')?.getAttribute('data-snippets-url') ?? '../data/snippets.json';
  const initialParams = new URLSearchParams(location.search);
  const PAGE_SIZE = 20;
  let snippets = [];
  let currentPage = Math.max(1, Number.parseInt(initialParams.get('page') ?? '1', 10) || 1);
  query.value = initialParams.get('q') ?? '';

  function card(snippet) {
    const article = document.createElement('article'); article.className = 'snippet-card';
    const meta = document.createElement('p'); meta.className = 'catalog-meta';
    const typeLabel = document.createElement('span'); typeLabel.textContent = snippet.typeLabel;
    const separator = document.createTextNode(' · ');
    const courseLink = document.createElement('a'); courseLink.href = snippet.courseUrl; courseLink.textContent = courseNames[snippet.course] ?? snippet.courseTitle;
    meta.append(typeLabel, separator, courseLink);
    const heading = document.createElement('h3'); heading.textContent = snippet.title;
    const tags = document.createElement('p'); tags.className = 'catalog-tags';
    snippet.tags.forEach((tag) => { const item = document.createElement('span'); item.textContent = tag; tags.append(item); });
    const pre = document.createElement('pre'); const code = document.createElement('code'); code.textContent = snippet.content; pre.append(code);
    const actions = document.createElement('div'); actions.className = 'prompt-actions';
    const copy = document.createElement('button'); copy.type = 'button'; copy.textContent = '자료 복사';
    copy.addEventListener('click', async () => { await navigator.clipboard.writeText(snippet.content); copy.textContent = '복사됨'; setTimeout(() => { copy.textContent = '자료 복사'; }, 1200); });
    const wikiLink = document.createElement('a'); wikiLink.href = snippet.relatedWikiUrl; wikiLink.textContent = '관련 Wiki 문서';
    actions.append(copy, wikiLink);
    article.append(meta, heading, tags, pre, actions);
    return article;
  }

  function syncUrl() {
    const params = new URLSearchParams();
    if (query.value.trim()) params.set('q', query.value.trim());
    if (type.value) params.set('type', type.value);
    if (course.value) params.set('course', course.value);
    if (currentPage > 1) params.set('page', String(currentPage));
    const search = params.toString();
    history.replaceState(null, '', search ? `?${search}` : location.pathname);
  }

  function render({ updateUrl = true } = {}) {
    const needle = query.value.trim().toLowerCase();
    const filtered = snippets.filter((snippet) => (!type.value || snippet.type === type.value) && (!course.value || snippet.course === course.value) && (!needle || `${snippet.title} ${snippet.content} ${snippet.tags.join(' ')}`.toLowerCase().includes(needle)));
    const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    currentPage = Math.min(Math.max(1, currentPage), totalPages);
    const start = (currentPage - 1) * PAGE_SIZE;
    const end = Math.min(start + PAGE_SIZE, filtered.length);
    results.replaceChildren(...filtered.slice(start, end).map(card));
    count.textContent = filtered.length ? `${filtered.length}개 중 ${start + 1}–${end}번째 자료` : '조건에 맞는 코드·설정 자료가 없다.';
    pagination.hidden = filtered.length <= PAGE_SIZE;
    previousPage.disabled = currentPage <= 1;
    nextPage.disabled = currentPage >= totalPages;
    pageStatus.textContent = `${currentPage} / ${totalPages} 페이지`;
    if (updateUrl) syncUrl();
  }

  fetch(dataUrl).then((response) => {
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json();
  }).then((data) => {
    snippets = data.snippets;
    [...new Map(snippets.map((item) => [item.type, item.typeLabel])).entries()].forEach(([id, label]) => { const option = document.createElement('option'); option.value = id; option.textContent = label; type.append(option); });
    [...new Set(snippets.map((item) => item.course))].forEach((id) => { const option = document.createElement('option'); option.value = id; option.textContent = courseNames[id] ?? id; course.append(option); });
    type.value = [...type.options].some((option) => option.value === initialParams.get('type')) ? initialParams.get('type') : '';
    course.value = [...course.options].some((option) => option.value === initialParams.get('course')) ? initialParams.get('course') : '';
    render({ updateUrl: false });
  }).catch(() => { count.textContent = '코드·설정 자료를 불러오지 못했다.'; });
  [query, type, course].forEach((control) => control?.addEventListener('input', () => { currentPage = 1; render(); }));
  previousPage?.addEventListener('click', () => { if (currentPage > 1) { currentPage -= 1; render(); results.scrollIntoView({ block: 'start' }); } });
  nextPage?.addEventListener('click', () => { currentPage += 1; render(); results.scrollIntoView({ block: 'start' }); });
</script>
