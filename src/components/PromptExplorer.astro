<section class="prompt-explorer" aria-labelledby="prompt-explorer-title" data-prompts-url="../data/prompts.json">
  <div class="explorer-controls prompt-controls">
    <label class="explorer-search">프롬프트 검색
      <input id="prompt-query" type="search" placeholder="예: 보고서, RAG, 고객 이메일" autocomplete="off" />
    </label>
    <div class="explorer-filter">
      <span class="explorer-filter-label">코스</span>
      <details id="prompt-course-menu" class="prompt-course-menu">
        <summary aria-haspopup="listbox" aria-expanded="false"><span id="prompt-course-label">전체 코스</span></summary>
        <div id="prompt-course-options" class="prompt-course-options" role="listbox" aria-label="프롬프트 코스"></div>
      </details>
    </div>
    <label>작성 예시
      <select id="prompt-examples"><option value="">전체</option><option value="yes">예시 있음</option><option value="no">예시 없음</option></select>
    </label>
  </div>
  <p id="prompt-count" class="explorer-count" aria-live="polite">프롬프트를 불러오는 중…</p>
  <div id="prompt-results" class="prompt-results"></div>
  <nav id="prompt-pagination" class="wiki-pagination" aria-label="프롬프트 목록 페이지" hidden>
    <button id="prompt-prev" type="button">이전</button>
    <span id="prompt-page-status" aria-live="polite"></span>
    <button id="prompt-next" type="button">다음</button>
  </nav>
</section>

<script>
  const courseNames = { 'ai-foundations':'AI 기초','llm-internals':'LLM 내부 구조','model-training':'모델 학습과 튜닝','rag-search':'임베딩과 RAG','api-development':'AI API 개발','agent-systems':'AI 에이전트','responsible-ai':'신뢰할 수 있는 AI','multimodal-ai':'멀티모달 AI','prompt-systems':'프롬프트 시스템 설계','llm-evaluation':'LLM 평가와 관측성','llmops-production':'LLMOps와 프로덕션 서빙','advanced-rag':'고급 RAG와 지식 시스템','production-agents':'프로덕션 AI 에이전트','post-training-alignment':'사후학습과 정렬 심화','ai-security-redteam':'AI 보안과 레드팀','multimodal-systems':'멀티모달 AI 시스템' };
  const courseOrder = Object.keys(courseNames);
  const query = document.querySelector('#prompt-query');
  const courseMenu = document.querySelector('#prompt-course-menu');
  const courseLabel = document.querySelector('#prompt-course-label');
  const courseOptions = document.querySelector('#prompt-course-options');
  const exampleFilter = document.querySelector('#prompt-examples'); const results = document.querySelector('#prompt-results'); const count = document.querySelector('#prompt-count');
  const promptDataUrl = document.querySelector('.prompt-explorer')?.getAttribute('data-prompts-url') ?? '../data/prompts.json';
  const pagination = document.querySelector('#prompt-pagination');
  const previousPage = document.querySelector('#prompt-prev');
  const nextPage = document.querySelector('#prompt-next');
  const pageStatus = document.querySelector('#prompt-page-status');
  const PAGE_SIZE = 40;
  let prompts = [];
  let selectedCourse = '';
  let currentPage = 1;
  const initialParams = new URLSearchParams(location.search);
  query.value = initialParams.get('q') ?? '';
  exampleFilter.value = initialParams.get('examples') ?? '';
  currentPage = Math.max(1, Number.parseInt(initialParams.get('page') ?? '1', 10) || 1);
  function card(prompt) {
    const article = document.createElement('article'); article.className = 'prompt-card';
    const meta = document.createElement('p'); meta.className = 'catalog-meta'; const courseLink = document.createElement('a'); courseLink.href = prompt.courseUrl; courseLink.textContent = courseNames[prompt.course] ?? prompt.courseTitle; meta.append(courseLink);
    const heading = document.createElement('h3'); heading.textContent = prompt.title;
    const badge = document.createElement('span'); badge.className = `example-badge ${prompt.examples.length ? 'has-example' : ''}`; badge.textContent = prompt.examples.length ? `작성 예시 ${prompt.examples.length}개` : '작성 예시 없음';
    const pre = document.createElement('pre'); const code = document.createElement('code'); code.textContent = prompt.template; pre.append(code);
    const actions = document.createElement('div'); actions.className = 'prompt-actions';
    const copy = document.createElement('button'); copy.type = 'button'; copy.textContent = '프롬프트 복사'; copy.addEventListener('click', async () => { await navigator.clipboard.writeText(prompt.template); copy.textContent = '복사됨 ✓'; setTimeout(() => copy.textContent = '프롬프트 복사', 1200); });
    const source = document.createElement('a'); source.href = prompt.relatedWikiUrl; source.textContent = '관련 Wiki 문서 →';
    const path = document.createElement('a'); path.href = prompt.courseUrl; path.textContent = '코스에서 보기 →';
    const tagRow = document.createElement('p'); tagRow.className = 'catalog-tags'; prompt.tags.forEach((tag) => { const item = document.createElement('span'); item.textContent = tag; tagRow.append(item); });
    actions.append(copy, source, path); article.append(meta, heading, badge, tagRow, pre, actions);
    if (prompt.notes) { const note = document.createElement('p'); note.className = 'prompt-note'; note.textContent = '사용 주의: ' + prompt.notes; article.append(note); }
    if (prompt.examples.length) {
      const details = document.createElement('details'); const summary = document.createElement('summary'); summary.textContent = '작성 예시 보기'; details.append(summary);
      prompt.examples.forEach((example) => {
        const h = document.createElement('h4'); h.textContent = example.label;
        const inputLabel = document.createElement('p'); inputLabel.className = 'example-label'; inputLabel.textContent = '입력 예시';
        const input = document.createElement('pre'); input.textContent = example.input; details.append(h, inputLabel, input);
        if (example.output) { const outputLabel = document.createElement('p'); outputLabel.className = 'example-label'; outputLabel.textContent = '출력 예시'; const output = document.createElement('pre'); output.textContent = example.output; details.append(outputLabel, output); }
      });
      article.append(details);
    }
    return article;
  }
  function syncUrl() {
    const params = new URLSearchParams();
    if (query.value.trim()) params.set('q', query.value.trim());
    if (selectedCourse) params.set('course', selectedCourse);
    if (exampleFilter.value) params.set('examples', exampleFilter.value);
    if (currentPage > 1) params.set('page', String(currentPage));
    const search = params.toString();
    history.replaceState(null, '', search ? `?${search}` : location.pathname);
  }
  function render({ updateUrl = true } = {}) {
    const needle = query.value.trim().toLowerCase();
    const filtered = prompts.filter((prompt) => (!selectedCourse || prompt.course === selectedCourse) && (!exampleFilter.value || (exampleFilter.value === 'yes') === Boolean(prompt.examples.length)) && (!needle || `${prompt.title} ${prompt.template} ${(prompt.tags ?? []).join(' ')}`.toLowerCase().includes(needle)));
    const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    currentPage = Math.min(Math.max(1, currentPage), totalPages);
    const start = (currentPage - 1) * PAGE_SIZE;
    const end = Math.min(start + PAGE_SIZE, filtered.length);
    results.replaceChildren(...filtered.slice(start, end).map(card));
    count.textContent = filtered.length ? `${filtered.length}개 중 ${start + 1}–${end}번째 프롬프트` : '조건에 맞는 프롬프트가 없습니다.';
    pagination.hidden = filtered.length <= PAGE_SIZE;
    previousPage.disabled = currentPage <= 1;
    nextPage.disabled = currentPage >= totalPages;
    pageStatus.textContent = `${currentPage} / ${totalPages} 페이지`;
    if (updateUrl) syncUrl();
  }
  fetch(promptDataUrl).then((response) => {
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json();
  }).then((data) => {
    prompts = data.prompts;
    const availableCourses = new Set(prompts.map((item) => item.course));
    const courseIds = courseOrder.filter((id) => availableCourses.has(id));
    const makeCourseOption = (id, label) => {
      const option = document.createElement('button');
      option.type = 'button'; option.role = 'option'; option.dataset.courseValue = id;
      option.textContent = label; option.setAttribute('aria-selected', 'false');
      return option;
    };
    courseOptions.replaceChildren(makeCourseOption('', '전체 코스'), ...courseIds.map((id) => makeCourseOption(id, courseNames[id])));
    const selectCourse = (id, { update = true } = {}) => {
      selectedCourse = courseIds.includes(id) ? id : '';
      courseLabel.textContent = selectedCourse ? courseNames[selectedCourse] : '전체 코스';
      courseOptions.querySelectorAll('[data-course-value]').forEach((option) => option.setAttribute('aria-selected', String(option.dataset.courseValue === selectedCourse)));
      courseMenu.open = false;
      if (update) { currentPage = 1; render(); }
    };
    courseOptions.addEventListener('click', (event) => {
      const option = event.target.closest('[data-course-value]');
      if (option) selectCourse(option.dataset.courseValue ?? '');
    });
    const requestedCourse = initialParams.get('course') ?? '';
    selectCourse(requestedCourse, { update: false });
    render({ updateUrl: false });
  }).catch(() => count.textContent = '프롬프트 목록을 불러오지 못했습니다.');
  [query, exampleFilter].forEach((control) => control?.addEventListener('input', () => { currentPage = 1; render(); }));
  courseMenu?.addEventListener('toggle', () => courseMenu.querySelector('summary')?.setAttribute('aria-expanded', String(courseMenu.open)));
  courseMenu?.addEventListener('keydown', (event) => { if (event.key === 'Escape') { courseMenu.open = false; courseMenu.querySelector('summary')?.focus(); } });
  document.addEventListener('click', (event) => { if (courseMenu?.open && !courseMenu.contains(event.target)) courseMenu.open = false; });
  previousPage?.addEventListener('click', () => { if (currentPage > 1) { currentPage -= 1; render(); results.scrollIntoView({ block: 'start' }); } });
  nextPage?.addEventListener('click', () => { currentPage += 1; render(); results.scrollIntoView({ block: 'start' }); });
</script>

