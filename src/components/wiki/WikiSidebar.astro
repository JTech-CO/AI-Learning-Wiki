    <a href="/course/rag-search/">임베딩과 RAG</a>
    <a href="/course/api-development/">AI API 개발</a>
    <a href="/course/agent-systems/">AI 에이전트</a>
    <a href="/course/responsible-ai/">신뢰할 수 있는 AI</a>
    <a href="/course/multimodal-ai/">멀티모달 AI</a>
    <details class="wiki-sidebar-more" open={showAdditionalCourses}>
      <summary>더 보기</summary>
      <div class="wiki-sidebar-more-links">
        {additionalCourses.map((course) => <a href={`/course/${course.id}/`}>{course.title}</a>)}
