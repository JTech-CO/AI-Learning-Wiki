---
import wiki from '../../../public/data/wiki-index.json';
import prompts from '../../../public/data/prompts.json';
import snippets from '../../../public/data/snippets.json';

const featured = wiki.articles.find((article) => article.id === 'large-language-model') ?? wiki.articles[0];
const categoryMap = new Map(wiki.categories.map((category) => [category.id, category]));
const recent = [...wiki.articles].sort((a, b) => b.reviewedAt.localeCompare(a.reviewedAt) || a.title.localeCompare(b.title, 'ko')).slice(0, 12);
const formatCount = (value) => Number(value).toLocaleString('ko-KR');
---
<div class="wiki-home">
  <header class="wiki-home-intro">
    <p class="wiki-home-name">AI Learning Wiki</p>
    <p>AI와 대규모 언어 모델의 원리, 용어, 기술을 서로 연결해 설명하는 한국어 백과사전이다.</p>
    <p class="wiki-counts">검토 완료 백과 문서 <strong>{formatCount(wiki.counts.articles)}</strong>개 · 학습 코스 <strong>{formatCount(wiki.counts.courses)}</strong>개 · 프롬프트 <strong>{formatCount(prompts.prompts.length)}</strong>개 · 코드·설정 자료 <strong>{formatCount(snippets.snippets.length)}</strong>개</p>
  </header>

  <div class="wiki-home-columns">
    <section class="wiki-home-section">
      <h2>분야별 백과 탐색</h2>
      <div class="wiki-category-index">
        {wiki.categories.map((category) => (
          <div>
            <h3><a href={`/category/${category.id}/`}>{category.title}</a> <span>{category.count}</span></h3>
            <p>{category.description}</p>
          </div>
        ))}
      </div>
    </section>

    <aside class="wiki-home-section wiki-featured">
      <h2>주요 문서</h2>
      <h3><a href={featured.url}>{featured.title}</a></h3>
      <p class="wiki-en">{featured.englishTitle}</p>
      <p>{featured.summary}</p>
      <p><a href={featured.url}>문서 읽기</a> · <a href={`/category/${featured.categories[0]}/`}>{categoryMap.get(featured.categories[0])?.title}</a></p>
      <h2>최근 검토</h2>
      <ul class="wiki-compact-list">
        {recent.map((article) => <li><a href={article.url}>{article.title}</a> <time>{article.reviewedAt}</time></li>)}
      </ul>
    </aside>
  </div>

  <section class="wiki-home-section wiki-course-browser" aria-labelledby="wiki-course-title">
    <h2 id="wiki-course-title">Wiki 학습 코스</h2>
    <p>백과 문서의 선행 관계를 따라 읽을 수 있도록 구성한 과정이다. 코스를 선택하지 않아도 위의 분류와 검색으로 모든 문서를 자유롭게 볼 수 있다.</p>
    <div class="wiki-course-tabs" role="tablist" aria-label="학습 코스 선택">
      {wiki.courses.map((course, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-course={course.id}>{course.title}</button>)}
    </div>
    {wiki.courses.map((course, index) => (
      <div class="wiki-course-sequence" data-course-panel={course.id} hidden={index !== 0}>
        <h3><a href={course.url}>{course.title}</a></h3>
        <p>{course.description}</p>
        <ol>
          {course.steps.slice(0, 12).map((step) => <li><a href={step.url}>{step.title}</a></li>)}
        </ol>
        <p><a href={course.url}>전체 {course.steps.length}단계 보기</a></p>
      </div>
    ))}
  </section>

  <div class="wiki-home-columns wiki-home-lower">
    <section class="wiki-home-section">
      <h2>바로 찾아보기</h2>
      <ul>
        <li><a href="/special/all-pages/">전체 문서(색인)</a></li>
        <li><a href="/special/random/" data-random-document>무작위 백과 문서</a></li>
        <li><a href="/search/">백과·프롬프트 통합 검색</a></li>
        <li><a href="/special/editor-quality/">편집 품질 대시보드</a></li>
      </ul>
    </section>
    <section class="wiki-home-section">
      <h2>AI 실험실</h2>
      <p>백과 문서의 관계, 평가·메모리 계산식과 프롬프트 출력 계약을 입력값으로 직접 확인하는 위키 연계 도구다.</p>
      <p><a href="/lab/learning-path/">맞춤 학습 경로 만들기</a> · <a href="/lab/evaluation-metrics/">평가 지표 계산하기</a> · <a href="/lab/model-memory/">모델 메모리 계산하기</a> · <a href="/lab/prompt-schema/">프롬프트·스키마 검증하기</a> · <a href="/lab/">실험실 둘러보기</a></p>
    </section>
    <section class="wiki-home-section">
      <h2>프롬프트 자료실</h2>
      <p>업무·개발·학습에 바로 쓸 수 있는 {prompts.prompts.length}개 프롬프트를 Wiki 코스와 관련 백과 문서에 연결했다.</p>
      <p><a href="/prompt-explorer/">프롬프트 검색하기</a></p>
      <p><a href="/snippet-explorer/">코드·설정 자료실 열기</a></p>
    </section>
  </div>
</div>

<script>
  const buttons = document.querySelectorAll('[data-course]');
  const panels = document.querySelectorAll('[data-course-panel]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    const id = button.dataset.course;
    buttons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));
    panels.forEach((panel) => { panel.hidden = panel.dataset.coursePanel !== id; });
  }));
</script>
