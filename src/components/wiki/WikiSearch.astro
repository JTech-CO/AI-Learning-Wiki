<section class="wiki-search-page" data-wiki-url="../data/wiki-index.json" data-prompts-url="../data/prompts.json" data-snippets-url="../data/snippets.json">
  <form id="wiki-search-form" class="wiki-page-search" role="search">
    <label for="wiki-search-query">백과·프롬프트·코드 검색</label>
    <div><input id="wiki-search-query" name="q" type="search" autocomplete="off" placeholder="예: 대규모 언어 모델, LLM, ㄷㄱㅁ" /><button type="submit">검색</button></div>
  </form>
  <div class="wiki-search-filters" aria-label="자료 유형">
    <button type="button" data-type="all" aria-pressed="true">전체</button>
    <button type="button" data-type="article" aria-pressed="false">백과 문서</button>
    <button type="button" data-type="prompt" aria-pressed="false">프롬프트</button>
    <button type="button" data-type="snippet" aria-pressed="false">코드·설정</button>
  </div>
  <div class="wiki-search-facets" aria-label="검색 결과 필터">
    <label>분야
      <select id="wiki-search-category"><option value="">전체 분야</option></select>
    </label>
    <label>코스
      <select id="wiki-search-course"><option value="">전체 코스</option></select>
    </label>
    <label>작성 예시
      <select id="wiki-search-examples"><option value="">전체</option><option value="yes">예시 있음</option><option value="no">예시 없음</option></select>
    </label>
  </div>
  <p id="wiki-search-count" aria-live="polite">검색어를 입력하거나 필터를 선택하면 필요한 자료만 불러온다.</p>
  <div id="wiki-search-results" class="wiki-search-results"></div>
  <nav id="wiki-search-pagination" class="wiki-pagination" aria-label="검색 결과 페이지" hidden>
    <button id="wiki-search-prev" type="button">이전</button>
    <span id="wiki-search-page-status" aria-live="polite"></span>
    <button id="wiki-search-next" type="button">다음</button>
  </nav>
</section>

<script>
  import { rankCatalogItems } from '../../lib/catalog-search.mjs';

  const CATEGORY_NAMES = {
    foundations: 'AI·머신러닝 기초', mathematics: '수학·통계 기초', neural: '신경망과 딥러닝', transformer: '트랜스포머와 모델 구조',
    llm: 'LLM과 토큰 처리', training: '학습과 사후학습', inference: '추론·서빙·최적화', retrieval: '임베딩·검색·RAG',
    evaluation: '평가·벤치마크', safety: '안전·윤리·거버넌스', api: 'API·도구·통합', agents: '에이전트와 자동화',
    multimodal: '멀티모달 AI', ecosystem: '모델·서비스 생태계',
  };
  const COURSE_NAMES = {
    'ai-foundations':'AI 기초','llm-internals':'LLM 내부 구조','model-training':'모델 학습과 튜닝','rag-search':'임베딩과 RAG',
    'api-development':'AI API 개발','agent-systems':'AI 에이전트','responsible-ai':'신뢰할 수 있는 AI','multimodal-ai':'멀티모달 AI',
    'prompt-systems':'프롬프트 시스템 설계','llm-evaluation':'LLM 평가와 관측성','llmops-production':'LLMOps와 프로덕션 서빙',
    'advanced-rag':'고급 RAG와 지식 시스템','production-agents':'프로덕션 AI 에이전트','post-training-alignment':'사후학습과 정렬 심화',
    'ai-security-redteam':'AI 보안과 레드팀','multimodal-systems':'멀티모달 AI 시스템',
    'ai-mathematics-statistics':'AI를 위한 수학·통계','neural-model-architectures':'현대 신경망과 모델 아키텍처',
    'transformer-architecture':'트랜스포머 아키텍처','efficient-long-context-transformers':'효율적·장문맥 트랜스포머',
    'ai-serving-systems':'AI 시스템·하드웨어·서빙','model-service-ecosystem':'모델·서비스 생태계',
    'production-ai-api-systems':'프로덕션 AI API 시스템','data-training-pipelines':'데이터·학습 파이프라인',
  };
  const form = document.querySelector('#wiki-search-form');
  const input = document.querySelector('#wiki-search-query');
  const count = document.querySelector('#wiki-search-count');
  const results = document.querySelector('#wiki-search-results');
  const filterButtons = [...document.querySelectorAll('[data-type]')];
  const categoryFilter = document.querySelector('#wiki-search-category');
  const courseFilter = document.querySelector('#wiki-search-course');
  const exampleFilter = document.querySelector('#wiki-search-examples');
  const searchPage = document.querySelector('.wiki-search-page');
  const pagination = document.querySelector('#wiki-search-pagination');
  const previousPage = document.querySelector('#wiki-search-prev');
  const nextPage = document.querySelector('#wiki-search-next');
  const pageStatus = document.querySelector('#wiki-search-page-status');
  const wikiDataUrl = searchPage?.getAttribute('data-wiki-url') ?? '../data/wiki-index.json';
  const promptDataUrl = searchPage?.getAttribute('data-prompts-url') ?? '../data/prompts.json';
  const snippetDataUrl = searchPage?.getAttribute('data-snippets-url') ?? '../data/snippets.json';
  const promptLibraryUrl = new URL('../prompt-explorer/', location.href).pathname;
  const snippetLibraryUrl = new URL('../snippet-explorer/', location.href).pathname;
  const PAGE_SIZE = 30;
  const validTypes = new Set(['all', 'article', 'prompt', 'snippet']);
  const initialParams = new URLSearchParams(location.search);
  const itemStores = { article: null, prompt: null, snippet: null };
  const pendingLoads = {};
  let activeType = validTypes.has(initialParams.get('type')) ? initialParams.get('type') : 'all';
  let currentPage = Math.max(1, Number.parseInt(initialParams.get('page') ?? '1', 10) || 1);
  let renderVersion = 0;
  let debounceTimer;

  input.value = initialParams.get('q') ?? '';
  filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.type === activeType)));
  for (const [id, label] of Object.entries(CATEGORY_NAMES)) categoryFilter.add(new Option(label, id));
  for (const [id, label] of Object.entries(COURSE_NAMES)) courseFilter.add(new Option(label, id));
  categoryFilter.value = initialParams.get('category') in CATEGORY_NAMES ? initialParams.get('category') : '';
  courseFilter.value = initialParams.get('course') in COURSE_NAMES ? initialParams.get('course') : '';
  exampleFilter.value = ['yes', 'no'].includes(initialParams.get('examples')) ? initialParams.get('examples') : '';

  const deepLink = (base, kind, id) => `${base}?id=${encodeURIComponent(id)}#${kind}-${encodeURIComponent(id)}`;
  const preview = (value, limit = 180) => value.length > limit ? `${value.slice(0, limit).trimEnd()}…` : value;

  function resultCard(item) {
    const article = document.createElement('article');
    const type = document.createElement('p');
    const heading = document.createElement('h2');
    const link = document.createElement('a');
    const summary = document.createElement('p');
    type.textContent = item.matchReason ? `${item.typeLabel} · ${item.matchReason}에서 일치` : item.typeLabel;
    link.href = item.url;
    link.textContent = item.title;
    summary.textContent = item.summary;
    heading.append(link);
    article.append(type, heading, summary);
    return article;
  }

  function syncUrl() {
    const params = new URLSearchParams();
    if (input.value.trim()) params.set('q', input.value.trim());
    if (activeType !== 'all') params.set('type', activeType);
    if (categoryFilter.value) params.set('category', categoryFilter.value);
    if (courseFilter.value) params.set('course', courseFilter.value);
    if (exampleFilter.value) params.set('examples', exampleFilter.value);
    if (currentPage > 1) params.set('page', String(currentPage));
    const search = params.toString();
    history.replaceState(null, '', search ? '?' + search : location.pathname);
  }

  const parseJson = (response) => {
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.json();
  };

  const dataLoaders = {
    article: () => fetch(wikiDataUrl).then(parseJson).then((wiki) => wiki.articles.map((item) => ({
      ...item, type: 'article', typeLabel: '백과 문서', searchText: item.summary,
      categoryLabels: (item.categories ?? []).map((id) => CATEGORY_NAMES[id] ?? id),
      courseLabels: (item.courses ?? []).map((id) => COURSE_NAMES[id] ?? id),
    }))),
    prompt: () => fetch(promptDataUrl).then(parseJson).then((data) => data.prompts.map((item) => ({
      ...item, type: 'prompt', typeLabel: '프롬프트', summary: preview(item.template), searchText: item.template,
      courseLabels: [COURSE_NAMES[item.course] ?? item.courseTitle], exampleCount: item.examples?.length ?? 0,
      url: deepLink(promptLibraryUrl, 'prompt', item.id),
    }))),
    snippet: () => fetch(snippetDataUrl).then(parseJson).then((data) => data.snippets.map((item) => ({
      ...item, type: 'snippet', typeLabel: '코드·설정', summary: preview(item.content), searchText: item.content,
      courseLabels: [COURSE_NAMES[item.course] ?? item.courseTitle],
      url: deepLink(snippetLibraryUrl, 'snippet', item.id),
    }))),
  };

  async function loadType(type) {
    if (itemStores[type]) return itemStores[type];
    if (!pendingLoads[type]) pendingLoads[type] = dataLoaders[type]().then((items) => (itemStores[type] = items));
    return pendingLoads[type];
  }

  function requestedTypes() {
    if (activeType !== 'all') return [activeType];
    if (categoryFilter.value) return ['article'];
    if (exampleFilter.value) return ['prompt'];
    return ['article', 'prompt', 'snippet'];
  }

  function matchesFacets(item) {
    if (categoryFilter.value && !(item.categories ?? []).includes(categoryFilter.value)) return false;
    const courses = item.courses ?? (item.course ? [item.course] : []);
    if (courseFilter.value && !courses.includes(courseFilter.value)) return false;
    if (exampleFilter.value) {
      if (item.type !== 'prompt') return false;
      if ((exampleFilter.value === 'yes') !== Boolean(item.exampleCount)) return false;
    }
    return activeType === 'all' || item.type === activeType;
  }

  async function render({ updateUrl = true } = {}) {
    const version = ++renderVersion;
    const needle = input.value.trim();
    const hasFacet = Boolean(categoryFilter.value || courseFilter.value || exampleFilter.value);
    if (!needle && !hasFacet) {
      count.textContent = '검색어를 입력하거나 필터를 선택하면 필요한 자료만 불러온다.';
      results.replaceChildren();
      pagination.hidden = true;
      currentPage = 1;
      if (updateUrl) syncUrl();
      return;
    }

    count.textContent = '검색 자료를 불러오는 중…';
    pagination.hidden = true;
    try {
      const types = requestedTypes();
      const loaded = await Promise.all(types.map(loadType));
      if (version !== renderVersion) return;
      const items = loaded.flat().filter(matchesFacets);
      const ranked = rankCatalogItems(items, needle);
      const totalPages = Math.max(1, Math.ceil(ranked.length / PAGE_SIZE));
      currentPage = Math.min(Math.max(1, currentPage), totalPages);
      const start = (currentPage - 1) * PAGE_SIZE;
      const end = Math.min(start + PAGE_SIZE, ranked.length);
      const pageItems = ranked.slice(start, end).map(({ item, reason }) => ({ item: { ...item, matchReason: reason } }));
      count.textContent = ranked.length ? ranked.length + '개 중 ' + (start + 1) + '–' + end + '번째 결과' : '검색 결과가 없다.';
      results.replaceChildren(...pageItems.map(({ item }) => resultCard(item)));
      pagination.hidden = ranked.length <= PAGE_SIZE;
      previousPage.disabled = currentPage <= 1;
      nextPage.disabled = currentPage >= totalPages;
      pageStatus.textContent = currentPage + ' / ' + totalPages + ' 페이지';
      if (updateUrl) syncUrl();
    } catch {
      if (version !== renderVersion) return;
      count.textContent = '검색 자료를 불러오지 못했다.';
      results.replaceChildren();
      pagination.hidden = true;
    }
  }

  form?.addEventListener('submit', (event) => { event.preventDefault(); currentPage = 1; render(); });
  input?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => { currentPage = 1; render(); }, 160);
  });
  [categoryFilter, courseFilter, exampleFilter].forEach((control) => control?.addEventListener('change', () => { currentPage = 1; render(); }));
  filterButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      activeType = button.dataset.type;
      currentPage = 1;
      filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      render();
    });
    button.addEventListener('keydown', (event) => {
      const keyTargets = { ArrowRight: (index + 1) % filterButtons.length, ArrowLeft: (index - 1 + filterButtons.length) % filterButtons.length, Home: 0, End: filterButtons.length - 1 };
      if (!(event.key in keyTargets)) return;
      event.preventDefault();
      filterButtons[keyTargets[event.key]].focus();
      filterButtons[keyTargets[event.key]].click();
    });
  });
  previousPage?.addEventListener('click', () => { if (currentPage > 1) { currentPage -= 1; render(); results.scrollIntoView({ block: 'start' }); } });
  nextPage?.addEventListener('click', () => { currentPage += 1; render(); results.scrollIntoView({ block: 'start' }); });

  if (input.value.trim() || categoryFilter.value || courseFilter.value || exampleFilter.value) render({ updateUrl: false });
</script>
