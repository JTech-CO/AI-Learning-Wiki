---
import Pagination from 'virtual:starlight/components/Pagination';
import LearningCheck from '../learning/LearningCheck.astro';

const currentYear = new Date().getFullYear();
---

<footer class="wiki-site-footer">
  <LearningCheck />
  <Pagination />
  <div class="wiki-site-footer__content">
    <nav aria-label="사이트 정보">
      <a href="/">대문</a>
      <a href="/privacy-policy/">개인정보 처리방침</a>
      <a href="/terms-of-use/">이용약관</a>
      <a href="https://github.com/JTech-CO/AI-Learning-Wiki" target="_blank" rel="noreferrer">GitHub</a>
    </nav>
    <p>© {currentYear} AI Learning Wiki. AI·LLM 학습을 위한 공개 백과사전이다.</p>
  </div>
</footer>

<style>
  .wiki-site-footer {
    margin-top: 3rem;
  }

  .wiki-site-footer__content {
    border-top: 1px solid var(--sl-color-hairline-shade);
    padding: 1rem 0 1.5rem;
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
  }

  .wiki-site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
  }

  .wiki-site-footer p {
    margin: 0.55rem 0 0;
  }
</style>
